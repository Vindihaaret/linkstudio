msgid "No Insta360 Link Found"
msgstr "Fant ingen Insta360 Link"

#: src/ui.rs:602
msgid "Connect the camera with USB. Link Studio connects automatically."
msgstr "Koble til kameraet med USB. Link Studio kobler seg til automatisk."

