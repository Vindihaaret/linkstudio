msgstr "OK"

#: src/ui/update.rs:256
msgid "You have version {}."
msgstr "Du har versjon {}."

#: src/ui/update.rs:259
msgid ""
"Link Studio runs from a source folder. Update it with “git pull” and run "
"install.sh."
msgstr ""
"Link Studio kjører fra en kildekodemappe. Oppdater med «git pull» og kjør "
"install.sh."

#: src/ui/update.rs:283
msgid "Skip This Version"
msgstr "Hopp over denne versjonen"

#: src/ui/update.rs:284 src/ui/update.rs:399
